{
  "name": "ledgeriq",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:tenancy": "vitest run --project tenancy",
    "db:migrate": "node --import tsx packages/db/src/cli/migrate.ts",
    "db:reset": "node --import tsx packages/db/src/cli/reset.ts",
    "cli": "node --import tsx apps/cli/src/index.ts",
    "demo": "node --import tsx apps/cli/src/index.ts demo",
    "web": "node --import tsx apps/web/src/server.ts",
    "export": "node --import tsx apps/web/src/export.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}